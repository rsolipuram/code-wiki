{
  "description": "Intelligent code quality checking on Stop event",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/quality-check.py",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
