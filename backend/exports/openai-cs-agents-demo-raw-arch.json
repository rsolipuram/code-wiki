      "description": "Tools access mock airline data to simulate real-world operations without external APIs"
    },
    {
      "source": "Agent Orchestration",
      "destination": "Guardrails",
      "description": "Agent inputs and outputs are checked by guardrails for relevance and safety before processing"
    },
    {
      "source": "ChatKit Server",
      "destination": "Memory Store",
      "description": "Conversation threads, messages, and state are persisted to and retrieved from the in-memory store"
