# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://codewiki:codewiki@localhost:5432/codewiki
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codewiki

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM (LM Studio with QwenCoder - Local)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=Qwen2.5-Coder-7B-Instruct
LLM_API_KEY=not-needed

# Redis
REDIS_URL=redis://localhost:6379

# Repository Storage
REPO_CACHE_DIR=./cache/repos

# Performance
MAX_CONCURRENT_PARSES=5
PARSE_TIMEOUT_SECONDS=900

# Feature Flags
ENABLE_CHAT=true
ENABLE_DIAGRAMS=false
