# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://codewiki:codewiki@localhost:5432/codewiki
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codewiki

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM (LM Studio with QwenCoder - Local)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=Qwen2.5-Coder-7B-Instruct
LLM_API_KEY=not-needed

# LLM (Analysis/Chat) - GitHub Models
# LLM_PROVIDER=github
# LLM_MODEL=openai/gpt-4.1-mini
# GITHUB_TOKEN=ghp_your_token_here
# Note: GitHub Models requires a PAT with models:read scope
# Note: Embeddings require a separate provider (e.g., local LM Studio)

# Redis
REDIS_URL=redis://localhost:6379

# Repository Storage
REPO_CACHE_DIR=./cache/repos

# Performance
MAX_CONCURRENT_PARSES=5
PARSE_TIMEOUT_SECONDS=900
WIKI_AGENT_INVOKE_TIMEOUT_SECONDS=0
WIKI_AGENT_IDLE_TIMEOUT_SECONDS=300

# Feature Flags
ENABLE_CHAT=true
ENABLE_DIAGRAMS=false
